# DockerSafe Configuration Example
PROJECT_NAME="DockerSafe"
ENVIRONMENT="development"

# Docker Settings
POSTGRES_IMAGE="postgres:16-alpine"
PG_READY_TIMEOUT_SECONDS=40

# Database
# Default uses local SQLite inside data/dockersafe.db
DATABASE_URL="sqlite:///./data/dockersafe.db"

# Security Labels
DOCKER_LABEL_PREFIX="dockersafe"
MANAGED_LABEL_KEY="dockersafe.managed"
MANAGED_LABEL_VALUE="true"
